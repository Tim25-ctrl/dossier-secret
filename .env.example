# Copiez ce fichier en ".env" si vous voulez modifier les valeurs par défaut.
# Aucune clé secrète n'est nécessaire pour faire fonctionner Dossier Secret.

# Port HTTP du serveur (Render et la plupart des hébergeurs le fournissent automatiquement)
PORT=3001

# Dossier où le serveur sauvegarde l'état des salons (vide = pas de sauvegarde sur disque)
DATA_DIR=./data

# Autoriser l'hôte à ajouter des joueurs automatiques (bots) dans le lobby : true / false
ENABLE_BOTS=true

# Durées en secondes
FALSIFICATION_WINDOW_SECONDS=8
RESPONSE_TIMEOUT_SECONDS=60
TURN_TIMEOUT_SECONDS=180
DISCONNECTED_TURN_SECONDS=25

# Origines autorisées pour les WebSockets, séparées par des virgules (vide = même origine uniquement)
# Exemple : CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
